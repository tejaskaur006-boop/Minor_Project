import requests
import time
from dotenv import load_dotenv
import os
import sys
sys.stdout.reconfigure(encoding="utf-8")
load_dotenv()
FACEBOOK_USER_ACCESS_TOKEN = os.getenv("FACEBOOK_USER_ACCESS_TOKEN")
PAGE_ACCESS_TOKEN = os.getenv("FACEBOOK_PAGE_ACCESS_TOKEN")
IG_USER_ID = os.getenv("INSTAGRAM_BUSINESS_ACCOUNT_ID")

# ============================================================
# CONFIGURATION
# ============================================================


BASE_URL = "https://graph.facebook.com/v26.0"

def get_pages():
    print("\n--- FACEBOOK PAGES ---")

    url = f"{BASE_URL}/me/accounts"

    params = {
        "fields": "name,id,access_token,instagram_business_account",
        "access_token": FACEBOOK_USER_ACCESS_TOKEN
    }

    response = requests.get(url, params=params)

    print("Status Code:", response.status_code)
    print("Response:", response.json())

    return response.json()
# ============================================================
# 1. GET ACCOUNT DETAILS
# ============================================================
def get_account():
    print("\n--- INSTAGRAM ACCOUNT DETAILS ---")

    ig_user_id = os.getenv("INSTAGRAM_BUSINESS_ACCOUNT_ID")

    url = f"{BASE_URL}/{ig_user_id}"

    params = {
        "fields": "id,username,account_type,media_count",
        "access_token": PAGE_ACCESS_TOKEN
    }

    response = requests.get(url, params=params)

    print("Status Code:", response.status_code)

    if response.ok:
        data = response.json()

        print("Instagram ID:", data.get("id"))
        print("Username:", data.get("username"))
        print("Account Type:", data.get("account_type"))
        print("Media Count:", data.get("media_count"))

        return data

    else:
        print("Error:", response.json())
        return None

# ============================================================
# 2. GET YOUR POSTS
# ============================================================
def get_posts():
    print("\n--- YOUR INSTAGRAM POSTS ---")

    url = f"{BASE_URL}/{IG_USER_ID}/media"

    params = {
        "fields": "id,caption,media_type,media_url,permalink,timestamp",
        "access_token": PAGE_ACCESS_TOKEN
    }

    response = requests.get(url, params=params)

    print("Status Code:", response.status_code)

    if response.ok:
        data = response.json()

        for post in data.get("data", []):
            print("\nPost ID:", post.get("id"))
            print("Type:", post.get("media_type"))
            print("Caption:", post.get("caption"))
            print("URL:", post.get("permalink"))
            print("Date:", post.get("timestamp"))

        return data

    else:
        print("Error:", response.json())
        return None


# ============================================================
# 3. PUBLISH AN IMAGE
# ============================================================
def publish_image(image_url, caption):
    print("\n--- PUBLISHING IMAGE ---")

    url = f"{BASE_URL}/{IG_USER_ID}/media"

    params = {
        "image_url": image_url,
        "caption": caption,
        "access_token": PAGE_ACCESS_TOKEN
    }

    response = requests.post(url, params=params)

    print("Status Code:", response.status_code)

    if not response.ok:
        print("Container creation failed:")
        print(response.json())
        return None

    creation_id = response.json().get("id")

    print("Container created:", creation_id)

    # Wait for Instagram to process the image
    time.sleep(5)

    publish_url = f"{BASE_URL}/{IG_USER_ID}/media_publish"

    publish_params = {
        "creation_id": creation_id,
        "access_token": PAGE_ACCESS_TOKEN
    }

    publish_response = requests.post(
        publish_url,
        params=publish_params
    )

    print("Publish Status Code:", publish_response.status_code)

    if publish_response.ok:
        media_id = publish_response.json().get("id")

        print("Image published successfully!")
        print("Media ID:", media_id)

        return media_id

    else:
        print("Publishing failed:")
        print(publish_response.json())

        return None

# ============================================================
# 4. PUBLISH A REEL
# ============================================================
def publish_reel(video_url, caption):
    print("\n--- PUBLISHING REEL ---")

    # Step 1: Create Reel container
    url = f"{BASE_URL}/{IG_USER_ID}/media"

    params = {
        "media_type": "REELS",
        "video_url": video_url,
        "caption": caption,
        "access_token": PAGE_ACCESS_TOKEN
    }

    response = requests.post(url, params=params)

    print("Status Code:", response.status_code)

    if not response.ok:
        print("Reel container creation failed:")
        print(response.json())
        return None

    creation_id = response.json().get("id")

    print("Reel container created:", creation_id)

    # Step 2: Check processing status
    status_url = f"{BASE_URL}/{creation_id}"

    for attempt in range(12):

        time.sleep(10)

        status_params = {
            "fields": "status_code,status",
            "access_token": PAGE_ACCESS_TOKEN
        }

        status_response = requests.get(
            status_url,
            params=status_params
        )

        print("Processing check:", attempt + 1)

        if not status_response.ok:
            print("Could not check processing status:")
            print(status_response.json())
            return None

        status_data = status_response.json()

        print("Status:", status_data)

        status_code = status_data.get("status_code")

        if status_code == "FINISHED":

            print("Video processing completed!")
            break

        elif status_code == "ERROR":

            print("Instagram reported a processing error.")
            return None

        elif status_code == "EXPIRED":

            print("Reel container expired.")
            return None

        else:

            print("Video is still processing...")

    else:

        print("Video did not finish processing within the waiting period.")
        return None

    # Step 3: Publish the Reel
    publish_url = f"{BASE_URL}/{IG_USER_ID}/media_publish"

    publish_params = {
        "creation_id": creation_id,
        "access_token": PAGE_ACCESS_TOKEN
    }

    publish_response = requests.post(
        publish_url,
        params=publish_params
    )

    print("Publish Status Code:", publish_response.status_code)

    if publish_response.ok:

        media_id = publish_response.json().get("id")

        print("Reel published successfully!")
        print("Media ID:", media_id)

        return media_id

    else:

        print("Reel publishing failed:")
        print(publish_response.json())

        return None

    
# ============================================================
# 5. GET COMMENTS ON A POST
# ============================================================

def get_comments(media_id):

    print("\n--- COMMENTS ---")

    url = f"{BASE_URL}/{media_id}/comments"

    params = {
        "fields": "id,text,username,timestamp",
        "access_token": PAGE_ACCESS_TOKEN
    }

    response = requests.get(url, params=params)

    print("Status Code:", response.status_code)
    print("Raw Response:", response.json())

    if response.ok:

        data = response.json()

        comments = data.get("data", [])

        if not comments:
            print("No comments returned by Instagram API.")

        for comment in comments:

            print("\nComment ID:", comment.get("id"))
            print("Username:", comment.get("username"))
            print("Comment:", comment.get("text"))
            print("Time:", comment.get("timestamp"))

        return data

    else:

        print("Could not get comments:")
        print(response.json())

        return None

# ============================================================
# 6. REPLY TO A COMMENT
# ============================================================

def reply_to_comment(comment_id, reply_text):
    print("\n--- REPLYING TO COMMENT ---")

    url = f"{BASE_URL}/{comment_id}/replies"

    params = {
        "message": reply_text,
        "access_token": PAGE_ACCESS_TOKEN
    }

    response = requests.post(url, params=params)

    if response.ok:
        reply_id = response.json().get("id")
        print("Reply posted successfully!")
        print("Reply ID:", reply_id)
        return reply_id

    else:
        print("Reply failed:")
        print(response.json())
        return None
    
